__pycache__/
*.pyc

# Generated dataset files (too large for git)
Phase 4/processed/*_chunks/
Phase 4/processed/*.pt
Phase 4/data/processed/

# Model checkpoints (binary, too large for git)
Phase 4/checkpoints/

# Phase 5 — REGENERABLE artifacts only. Everything that backs a result stays tracked:
# results/ (figures + csv + the per-experiment .md), networks/ (the save-then-load contract —
# figures LOAD these and must never re-optimise), and m2/checkpoint.pt (the trained M2 model).
# M2 labelled data — rebuild: Phase 5/m2/build_dataset.py
Phase 5/dataset/
Phase 5/m2/data/
# per-panel high-DPI render elements — rebuild from networks/ via plotting.py
Phase 5/elements/
# loose top-level galleries (scratch; the kept figures live in results/)
Phase 5/*.png

# Runtime logs (and the stderr side-channel of detached background runs)
*.log
*.err
# M2 datasets: multi-hundred-MB generated artifacts, rebuildable from build_dataset.py + seed
Phase 5/m2/data/*.npz
# M2 per-evaluation RESUME snapshots (train_v3.py --resume): 10-16 MB intermediates written every
# evaluation so a multi-day run survives a power cut. The final checkpoint_*.pt supersedes them and
# IS tracked; the snapshot is only useful while its own run is still in flight.
Phase 5/m2/*.pt.resume
